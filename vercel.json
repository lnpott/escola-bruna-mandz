{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Frame-Options",           "value": "DENY" },
                { "key": "X-Content-Type-Options",     "value": "nosniff" },
                { "key": "Referrer-Policy",            "value": "strict-origin-when-cross-origin" },
                { "key": "Strict-Transport-Security",  "value": "max-age=63072000; includeSubDomains; preload" },
                { "key": "Permissions-Policy",         "value": "camera=(), microphone=(), geolocation=()" }
            ]
        },
        {
            "source": "/api/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "no-store" }
            ]
        }
    ],
    "rewrites": [
        { "source": "/app/:path(.*)",        "destination": "/app/index.html" },
        { "source": "/comercial",            "destination": "/commercial/index.html" },
        { "source": "/comercial/:path(.*)",  "destination": "/commercial/index.html" },
        { "source": "/commercial",           "destination": "/commercial/index.html" },
        { "source": "/commercial/:path(.*)", "destination": "/commercial/index.html" },
        { "source": "/academico",            "destination": "/app/index.html" },
        { "source": "/academico/:path(.*)",  "destination": "/app/index.html" }
    ]
}
